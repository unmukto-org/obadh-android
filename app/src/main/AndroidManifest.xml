<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Optional swipe downloads and opted-in KLIPY GIF/sticker browsing. Ordinary typing stays local. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="helium314.keyboard.latin.App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obadh">

        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider android:name=".media.MediaContentProvider" android:process=":keyboard" android:authorities="${applicationId}.media" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".media.MediaSettingsActivity" android:process=":keyboard" android:exported="false" />
        <!-- A picker opened by the IME must never reuse the Obadh settings task. -->
        <activity android:name=".media.MediaSearchActivity" android:process=":keyboard" android:exported="false" android:taskAffinity="" android:theme="@style/Theme.Obadh.MediaSearch" android:excludeFromRecents="true" android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity android:name=".app.ThemeActivity" android:exported="false" />

        <service
            android:name=".keyboard.ObadhInputMethodService"
            android:process=":keyboard"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <receiver android:name=".swipe.SwipeDownloadReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.DOWNLOAD_COMPLETE" /></intent-filter>
        </receiver>
        <receiver android:name=".swipe.KeyboardReloadReceiver" android:process=":keyboard" android:exported="false" />
        <receiver android:name=".swipe.SwipePreferenceReceiver" android:process=":keyboard" android:exported="false" />
        <receiver android:name=".settings.KeyboardDataReceiver" android:process=":keyboard" android:exported="false" />
        <receiver android:name=".settings.NativePreferenceReceiver" android:process=":keyboard" android:exported="false" />
    </application>
</manifest>
